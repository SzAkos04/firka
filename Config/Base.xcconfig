// Build settings shared by all targets.
// Your own signing goes in Config/Local.xcconfig, which is not in git:
//   APP_ID = hu.yourname.firka
//   DEVELOPMENT_TEAM = ABCDE12345
// APP_ID sets the app's bundle id, the widget's (APP_ID.widget) and the App Group (group.APP_ID).

APP_ID = hu.firkaios.app

// Optional: the address of your own server/push (notifications from a server, NTFY_PUSH_PLAN.md). In Local.xcconfig,
// with "/$()/" for "//" (xcconfig reads // as a comment): PUSH_SERVER = https:/$()/host.example.ts.net:8446
PUSH_SERVER =

#include? "Local.xcconfig"
